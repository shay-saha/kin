NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are also supported.
OPENAI_API_KEY=
# Blank uses the current code fallback gpt-4o.
OPENAI_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Choose the demo's voice in the provider configuration.
ELEVENLABS_VOICE_ID=
KIN_FAMILY_ID=670f5075-c286-4b29-8074-86401c18d0c0
# Conservative P0 minimum; permitted range 0.85–1.
KIN_GATE_THRESHOLD=0.85
# Next.js forwards API requests to this address; blank starts the local backend.
KIN_BACKEND_URL=
KIN_BRAIN_PORT=8787
KIN_BACKEND_BIND=127.0.0.1
KIN_FACE_WEIGHTS=brain/models
# Blank selects the Rust-native YuNet/SFace model.
KIN_FACE_MODEL=
# Optional external inference adapter; blank uses Rust-native inference.
# Legacy external model: face-api-1.7.15:ssd-mobilenetv1:landmark68:recognition128:rgb-exif-v1
KIN_FACE_SERVICE_URL=
KIN_FACE_SERVICE_TOKEN=
# Separate 32-byte random key encoded as 64 hexadecimal characters; server only.
KIN_FACE_TOKEN_KEY=
KIN_FACE_MAX_DISTANCE=0.45
KIN_FACE_MIN_MARGIN=0.10
