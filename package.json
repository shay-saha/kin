{
  "name": "kin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-app.mjs",
    "build": "next build",
    "start": "node scripts/run-app.mjs --production",
    "lint": "next lint",
    "test": "npm run test:web && npm run test:backend",
    "test:e2e": "node scripts/test-ui.mjs",
    "seed": "cargo run --manifest-path brain/Cargo.toml -- seed",
    "demo:audio": "cargo run --manifest-path brain/Cargo.toml -- demo-audio",
    "test:db": "npm --prefix tests/database test",
    "dev:web": "next dev",
    "dev:backend": "cargo run --manifest-path brain/Cargo.toml",
    "start:web": "next start",
    "build:backend": "cargo build --locked --release --manifest-path brain/Cargo.toml",
    "test:web": "vitest run",
    "test:backend": "cargo test --locked --manifest-path brain/Cargo.toml",
    "demo:provision": "cargo run --manifest-path brain/Cargo.toml -- provision-demo",
    "faces:models": "cargo run --manifest-path brain/Cargo.toml -- download-models"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "^15.5.25",
    "react": "^18",
    "react-dom": "^18",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
